{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "backend"
      ],
      "port": 3210
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-billing-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BILLING_ENABLED=true",
        "BILLING_ENTERPRISE_CONTACT_URL=mailto:sales@example.com",
        "BILLING_ENTERPRISE_PRICE_LABEL=From $22 per active contributor",
        "pnpm",
        "dev"
      ],
      "port": 3000
    }
  ]
}